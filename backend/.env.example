# Ollama Configuration
# Host URL where Ollama is running (default: localhost)
OLLAMA_HOST=http://localhost:11434

# Embedding model for vector search (must be pulled in Ollama first)
# Options: nomic-embed-text, snowflake-arctic-embed2, mxbai-embed-large
EMBEDDING_MODEL=nomic-embed-text

# Chat model for generating answers (must be pulled in Ollama first)
# Options: llama3.2, llama3, dolphin-mixtral, mistral, etc.
CHAT_MODEL=llama3.2

# Text Chunking Configuration
# Size of each text chunk in characters
CHUNK_SIZE=1000

# Overlap between consecutive chunks
CHUNK_OVERLAP=200
